#!/bin/sh
# Validates release-tag updates, then blocks the push unless the test suite
# passes. Git supplies one ref update per line on stdin.
set -eu

DIR=$(cd "$(dirname "$0")/.." && pwd)
REMOTE_NAME=${1:-origin}
UPDATES=$(mktemp)
trap 'rm -f "$UPDATES"' EXIT HUP INT TERM
cat > "$UPDATES"

is_zero_oid() {
    case "$1" in
        ''|*[!0]*) return 1 ;;
        *) return 0 ;;
    esac
}

while read -r local_ref local_oid remote_ref remote_oid; do
    [ -n "${remote_ref:-}" ] || continue

    case "$remote_ref" in
        refs/tags/v*)
            if is_zero_oid "$local_oid"; then
                echo "pre-push: refusing to delete release tag ${remote_ref#refs/tags/}" >&2
                echo "pre-push: release tags are immutable (use --no-verify only for recovery)" >&2
                exit 1
            fi

            "$DIR/.githooks/check-release-tag" \
                "$remote_ref" "$local_oid" "$remote_oid" "$REMOTE_NAME"
            ;;
    esac
done < "$UPDATES"

"$DIR/tests/verify.sh"
